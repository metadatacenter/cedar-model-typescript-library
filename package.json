{
  "name": "cedar-model-typescript-library",
  "version": "1.0.4",
  "description": "TypeScript models, builders, readers, writers, and validators for CEDAR metadata artifacts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "pretest": "node pretest.js",
    "test": "jest",
    "pretest:coverage": "node pretest.js",
    "test:coverage": "jest --coverage --runInBand",
    "generate:yaml:ts": "CEDAR_HOME=. ts-node ./itest/scripts/regenerate-yaml-files-with-ts-lib.ts",
    "generate:yaml:compact:ts": "CEDAR_HOME=. ts-node ./itest/scripts/regenerate-compact-yaml-files-with-ts-lib.ts",
    "generate:yaml:instances:ts": "CEDAR_HOME=. ts-node ./itest/scripts/regenerate-yaml-instances-with-ts-lib.ts",
    "generate:json:ts": "CEDAR_HOME=. ts-node ./itest/scripts/regenerate-json-files-with-ts-lib.ts",
    "verify:java-lock": "ts-node ./itest/scripts/verify-java-artifact-library-lock.ts",
    "verify:java-lock:source": "npm run verify:java-lock -- --check-siblings",
    "parity:json": "node itest/scripts/run-parity.js json",
    "parity:yaml:instances": "node itest/scripts/run-parity.js yaml-instances",
    "parity:yaml:compact": "node itest/scripts/run-parity.js yaml-compact",
    "parity:yaml": "node itest/scripts/run-parity.js yaml",
    "lint": "eslint \"src/**/*.ts\" eslint.config.js smoke-test-package.js itest/scripts/run-parity.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "sync:package-version": "node sync-package-version.js",
    "version": "npm run sync:package-version",
    "build": "rm -rf dist && npm run sync:package-version && webpack && cp package-dist.json dist/package.json && cp README.md dist/README.md && cp license.txt dist/license.txt",
    "test:package": "npm run build && node smoke-test-package.js",
    "build:watch": "webpack --watch",
    "prettier": "prettier --write .",
    "link": "cd dist && npm link",
    "unlink": "npm uninstall -g cedar-model-typescript-library",
    "publish:package": "npm run test:package && npm publish ./dist --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-model-typescript-library.git"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/metadatacenter/cedar-model-typescript-library/issues"
  },
  "homepage": "https://github.com/metadatacenter/cedar-model-typescript-library#readme",
  "engines": {
    "node": "^24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
