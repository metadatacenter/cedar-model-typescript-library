{
  "name": "cedar-model-typescript-library",
  "version": "0.9.2-dev.20260810.38cb9a1",
  "description": "CEDAR Model Typescript Library - a library to work with fields, elements, templates and instances implemented in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "pretest": "node pretest.js",
    "test": "jest",
    "pretest:coverage": "node pretest.js",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.ts\" eslint.config.js smoke-test-package.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "sync:package-version": "node sync-package-version.js",
    "version": "npm run sync:package-version",
    "build": "npm run sync:package-version && webpack && cp package-dist.json dist/package.json && cp README-dist.md dist/README.md",
    "test:package": "npm run build && node smoke-test-package.js",
    "build:watch": "webpack --watch",
    "prettier": "prettier --write .",
    "link": "cd dist && npm link",
    "unlink": "npm uninstall -g cedar-model-typescript-library"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-model-typescript-library.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/metadatacenter/cedar-model-typescript-library/issues"
  },
  "homepage": "https://github.com/metadatacenter/cedar-model-typescript-library#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
